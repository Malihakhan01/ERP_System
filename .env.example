# .env.example
# Copy this file to .env.local and fill in your Supabase project credentials.
# NEVER commit .env.local to version control.

# ----- Supabase (required for auth + database in Phase 2+) -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVICE ROLE KEY — NEVER expose to browser. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----- App -----
NEXT_PUBLIC_APP_NAME=FactoryOS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- AI (Phase 3+) — server-side only, never expose to browser -----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
